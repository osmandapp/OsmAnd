<?xml version="1.0" encoding="UTF-8"?>
<rules version="1">
    <index>
        <!-- IT-ABBR: internal dots need an indexed alternative token. Ambiguous V. is excluded. -->
        <variant object="street" source="(?iu)^Viale(?=\s)" target="V.le"/>
        <variant object="street" source="(?iu)^Piazza(?=\s)" target="P.za"/>
        <variant object="street" source="(?iu)^Corso(?=\s)" target="C.so"/>
        <variant object="street" source="(?iu)^Largo(?=\s)" target="L.go"/>

        <!-- RF1: the road number belongs to the same name as the full phrase. -->
        <variant object="street" source="(?iu)\bStrada\s+Statale\b" target="SS"/>
        <variant object="street" source="(?iu)\bStrada\s+Statale\s+(\d+)\b" target="SS$1"/>
        <variant object="street" source="(?iu)\bStrada\s+Provinciale\b" target="SP"/>
        <variant object="street" source="(?iu)\bStrada\s+Provinciale\s+(\d+)\b" target="SP$1"/>
        <variant object="street" source="(?iu)\bStrada\s+Regionale\b" target="SR"/>
        <variant object="street" source="(?iu)\bStrada\s+Regionale\s+(\d+)\b" target="SR$1"/>
    </index>
    <!-- EL1 uses UnglueRule; SA1 needs candidate-stage diagnosis before broad S. expansion. -->
    <query/>
</rules>
