<?xml version="1.0" encoding="UTF-8"?>
<rules version="1">
    <index>
        <!-- "St-Denis", "Ste-Foy": Saint and Sainte, never a street; common words of names as well -->
        <search key="st" value="Saint"/>
        <search key="ste" value="Sainte"/>
    </index>
    <query>
        <!-- query.db: the street type users shorten ("48 av. Gambetta", "rte de Certines"); OSM names are full. -->
        <variant object="street" source="(?iu)^Av\.?$" target="Avenue"/>
        <variant object="street" source="(?iu)^Bd\.?$" target="Boulevard"/>
        <variant object="street" source="(?iu)^Chem\.?$" target="Chemin"/>
        <variant object="street" source="(?iu)^Rte\.?$" target="Route"/>
        <variant object="street" source="(?iu)^Pl\.?$" target="Place"/>

        <!-- house number suffixes: "12 bis", "12ter" -->
        <building key="bis" value="Bis"/>
        <building key="ter" value="Ter"/>
        <building key="quater" value="Quater"/>

        <conjunction key="de"/>
        <conjunction key="du"/>
        <conjunction key="la"/>
        <conjunction key="le"/>
        <conjunction key="et"/>
    </query>
</rules>
