package = net.osmand.shared.icu
---

#include <stdint.h>
#include <unicode/ucol.h>

static inline void *openPrimaryCollator(const char *locale) {
    UErrorCode status = U_ZERO_ERROR;
    UCollator *collator = ucol_open(locale, &status);
    if (U_FAILURE(status)) return NULL;
    ucol_setStrength(collator, UCOL_PRIMARY);
    return collator;
}

static inline void closePrimaryCollator(void *collator) {
    ucol_close((UCollator *)collator);
}

static inline int compareSpan(void *collator, const void *base, int start, int length,
                              const void *part, int partLength) {
    return ucol_strcoll((const UCollator *)collator, (const UChar *)base + start, length,
                        (const UChar *)part, partLength);
}

static inline int equalsAtAnyOffset(void *collator, const void *base, int n, int length, const void *part,
                                    int partLength, const int32_t *offsets, int count) {
    for (int i = 0; i < count; i++) {
        int start = offsets[i];
        if (start < 0 || start > n - length) return -1;
        if (compareSpan(collator, base, start, length, part, partLength) == 0) return 1;
    }
    return 0;
}

static inline int containsSpan(void *collator, const void *base, int n, const void *part, int m) {
    if (m == 0) return 1;
    if (n <= m) return compareSpan(collator, base, 0, n, part, m) == 0;
    for (int start = 0; start <= n - m + 1; start++) {
        int remaining = n - start;
        int longest = remaining / 2 < m ? remaining : 2 * m;
        for (int len = longest; len >= 0; len--) {
            if (compareSpan(collator, base, start, len, part, m) == 0) return 1;
        }
        if (remaining == 0) break;
    }
    return 0;
}
