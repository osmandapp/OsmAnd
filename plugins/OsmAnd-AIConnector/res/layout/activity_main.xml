<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface"
	android:fitsSystemWindows="true"
	android:orientation="vertical">

	<com.google.android.material.appbar.MaterialToolbar
		android:id="@+id/toolbar"
		android:layout_width="match_parent"
		android:layout_height="?attr/actionBarSize"
		app:title="@string/app_name" />

	<ScrollView
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingStart="@dimen/gutter"
			android:paddingEnd="@dimen/gutter"
			android:paddingBottom="@dimen/group_gap">

			<TextView
				android:id="@+id/description"
				style="@style/TextAppearance.Material3.BodyMedium"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingBottom="@dimen/gutter"
				android:text="@string/screen_description"
				android:textColor="?attr/colorOnSurfaceVariant" />

			<!-- main switch: the whole row toggles the connector -->
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/main_card"
				style="@style/Widget.Material3.CardView.Filled"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="?attr/colorPrimaryContainer">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:gravity="center_vertical"
					android:orientation="horizontal"
					android:padding="@dimen/card_padding">

					<LinearLayout
						android:layout_width="0dp"
						android:layout_height="wrap_content"
						android:layout_weight="1"
						android:orientation="vertical">

						<TextView
							style="@style/TextAppearance.Material3.TitleMedium"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/main_switch"
							android:textColor="?attr/colorOnPrimaryContainer" />

						<TextView
							android:id="@+id/status"
							style="@style/TextAppearance.Material3.BodyMedium"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textColor="?attr/colorOnPrimaryContainer" />
					</LinearLayout>

					<com.google.android.material.materialswitch.MaterialSwitch
						android:id="@+id/main_switch"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:clickable="false"
						android:focusable="false" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<!-- how the connector runs: foreground service, or only while this screen is open -->
			<com.google.android.material.button.MaterialButtonToggleGroup
				android:id="@+id/run_mode_toggle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="12dp"
				app:selectionRequired="true"
				app:singleSelection="true">

				<Button
					android:id="@+id/run_background"
					style="?attr/materialButtonOutlinedStyle"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/run_in_background" />

				<Button
					android:id="@+id/run_while_open"
					style="?attr/materialButtonOutlinedStyle"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/run_while_open" />
			</com.google.android.material.button.MaterialButtonToggleGroup>

			<TextView
				android:id="@+id/run_mode_footer"
				style="@style/TextAppearance.Material3.BodySmall"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="8dp"
				android:textColor="?attr/colorOnSurfaceVariant" />

			<!-- screen mode: the connector works only while this screen is visible -->
			<com.google.android.material.card.MaterialCardView
				android:id="@+id/keep_screen_banner"
				style="@style/Widget.Material3.CardView.Filled"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="@dimen/gutter"
				android:visibility="gone"
				app:cardBackgroundColor="?attr/colorTertiaryContainer">

				<TextView
					style="@style/TextAppearance.Material3.BodyMedium"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:padding="@dimen/card_padding"
					android:text="@string/keep_screen_open"
					android:textColor="?attr/colorOnTertiaryContainer" />
			</com.google.android.material.card.MaterialCardView>

			<!-- 1. OsmAnd -->
			<TextView
				style="@style/TextAppearance.Material3.TitleSmall"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="@dimen/group_gap"
				android:paddingBottom="8dp"
				android:text="@string/step_osmand"
				android:textColor="?attr/colorPrimary" />

			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.Material3.CardView.Filled"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="@dimen/card_padding">

					<LinearLayout
						android:id="@+id/osmand_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:background="?attr/selectableItemBackground"
						android:orientation="vertical">

						<TextView
							style="@style/TextAppearance.Material3.BodyLarge"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/osmand_app" />

						<TextView
							android:id="@+id/osmand_name"
							style="@style/TextAppearance.Material3.BodyMedium"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:textColor="?attr/colorOnSurfaceVariant" />
					</LinearLayout>

					<TextView
						style="@style/TextAppearance.Material3.BodyLarge"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="@dimen/gutter"
						android:text="@string/access_title" />

					<TextView
						android:id="@+id/access_status"
						style="@style/TextAppearance.Material3.BodyMedium"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:textColor="?attr/colorOnSurfaceVariant" />

					<LinearLayout
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:orientation="horizontal">

						<Button
							android:id="@+id/allow_access"
							style="@style/Widget.Material3.Button"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/allow_access" />

						<Button
							android:id="@+id/check"
							style="@style/Widget.Material3.Button.TextButton"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginStart="8dp"
							android:text="@string/check_connection" />
					</LinearLayout>
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<TextView
				style="@style/TextAppearance.Material3.BodySmall"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="8dp"
				android:text="@string/osmand_footer"
				android:textColor="?attr/colorOnSurfaceVariant" />

			<!-- 2. Connection -->
			<TextView
				style="@style/TextAppearance.Material3.TitleSmall"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="@dimen/group_gap"
				android:paddingBottom="8dp"
				android:text="@string/step_connection"
				android:textColor="?attr/colorPrimary" />

			<com.google.android.material.button.MaterialButtonToggleGroup
				android:id="@+id/access_toggle"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:selectionRequired="true"
				app:singleSelection="true">

				<Button
					android:id="@+id/access_wifi"
					style="?attr/materialButtonOutlinedStyle"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/access_wifi" />

				<Button
					android:id="@+id/access_usb"
					style="?attr/materialButtonOutlinedStyle"
					android:layout_width="0dp"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:text="@string/access_usb" />
			</com.google.android.material.button.MaterialButtonToggleGroup>

			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.Material3.CardView.Filled"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="@dimen/card_padding">

					<!-- Wi-Fi only: the bridge finds the phone by name, without it the settings hold the address -->
					<LinearLayout
						android:id="@+id/bridge_row"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginBottom="12dp"
						android:background="?attr/selectableItemBackground"
						android:gravity="center_vertical"
						android:orientation="horizontal">

						<LinearLayout
							android:layout_width="0dp"
							android:layout_height="wrap_content"
							android:layout_weight="1"
							android:orientation="vertical">

							<TextView
								style="@style/TextAppearance.Material3.BodyLarge"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="@string/bridge_title" />

							<TextView
								style="@style/TextAppearance.Material3.BodyMedium"
								android:layout_width="wrap_content"
								android:layout_height="wrap_content"
								android:text="@string/bridge_summary"
								android:textColor="?attr/colorOnSurfaceVariant" />
						</LinearLayout>

						<com.google.android.material.materialswitch.MaterialSwitch
							android:id="@+id/bridge_switch"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:layout_marginStart="16dp"
							android:clickable="false"
							android:focusable="false" />
					</LinearLayout>

					<TextView
						android:id="@+id/access_footer"
						style="@style/TextAppearance.Material3.BodyMedium"
						android:layout_width="match_parent"
						android:layout_height="wrap_content" />

					<TextView
						android:id="@+id/setup_command"
						style="@style/CodeBlock"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:background="?attr/colorSurfaceContainerHighest"
						android:padding="12dp" />

					<Button
						android:id="@+id/copy_setup"
						style="@style/Widget.Material3.Button"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="@string/copy"
						app:icon="@drawable/ic_copy" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<!-- 3. Assistant -->
			<TextView
				style="@style/TextAppearance.Material3.TitleSmall"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="@dimen/group_gap"
				android:paddingBottom="8dp"
				android:text="@string/step_assistant"
				android:textColor="?attr/colorPrimary" />

			<HorizontalScrollView
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:scrollbars="none">

				<com.google.android.material.chip.ChipGroup
					android:id="@+id/clients"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					app:selectionRequired="true"
					app:singleLine="true"
					app:singleSelection="true" />
			</HorizontalScrollView>

			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.Material3.CardView.Filled"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:layout_marginTop="8dp"
				app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="@dimen/card_padding">

					<TextView
						android:id="@+id/client_where"
						style="@style/TextAppearance.Material3.BodyMedium"
						android:layout_width="match_parent"
						android:layout_height="wrap_content" />

					<TextView
						android:id="@+id/client_config"
						style="@style/CodeBlock"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:background="?attr/colorSurfaceContainerHighest"
						android:padding="12dp" />

					<Button
						android:id="@+id/copy"
						style="@style/Widget.Material3.Button"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="@string/copy"
						app:icon="@drawable/ic_copy" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>

			<!-- 4. Example -->
			<TextView
				style="@style/TextAppearance.Material3.TitleSmall"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:paddingTop="@dimen/group_gap"
				android:paddingBottom="8dp"
				android:text="@string/step_try"
				android:textColor="?attr/colorPrimary" />

			<com.google.android.material.card.MaterialCardView
				style="@style/Widget.Material3.CardView.Filled"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:cardBackgroundColor="?attr/colorSurfaceContainerLow">

				<LinearLayout
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:orientation="vertical"
					android:padding="@dimen/card_padding">

					<TextView
						style="@style/TextAppearance.Material3.BodyMedium"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:text="@string/try_where" />

					<TextView
						android:id="@+id/try_example"
						style="@style/TextAppearance.Material3.BodyLarge"
						android:layout_width="match_parent"
						android:layout_height="wrap_content"
						android:layout_marginTop="8dp"
						android:background="?attr/colorSurfaceContainerHighest"
						android:padding="12dp"
						android:text="@string/try_example"
						android:textIsSelectable="true" />

					<Button
						android:id="@+id/copy_example"
						style="@style/Widget.Material3.Button"
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_marginTop="12dp"
						android:text="@string/copy"
						app:icon="@drawable/ic_copy" />
				</LinearLayout>
			</com.google.android.material.card.MaterialCardView>
		</LinearLayout>
	</ScrollView>
</LinearLayout>
