<?xml version="1.0" encoding="utf-8"?><!--
	Content of MainSwitchView. Master toggle at the top of a feature or plugin screen.
	The whole row is the touch target, not just the switch.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	tools:parentTag="android.widget.LinearLayout">

	<net.osmand.plus.widgets.TextViewEx
		android:id="@+id/label"
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_gravity="center_vertical"
		android:layout_weight="1"
		android:paddingTop="@dimen/content_padding"
		android:paddingBottom="@dimen/content_padding"
		android:textColor="?attr/colorOnSurface"
		android:textSize="@dimen/default_list_text_size"
		app:lineHeight="@dimen/ui_line_height_title"
		app:typefaceWeight="medium"
		tools:text="@string/shared_string_on" />

	<com.google.android.material.materialswitch.MaterialSwitch
		android:id="@+id/switch_widget"
		android:layout_width="wrap_content"
		android:layout_height="@dimen/ui_switch_height"
		android:layout_gravity="center_vertical"
		android:layout_marginStart="@dimen/content_padding"
		android:clickable="false"
		android:focusable="false" />
</merge>
