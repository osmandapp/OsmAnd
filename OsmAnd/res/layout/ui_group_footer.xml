<?xml version="1.0" encoding="utf-8"?><!--
	Content of GroupFooterView. Explanatory text below the card it belongs to.
	Never truncated - a cut off explanation is worse than none.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	tools:parentTag="android.widget.FrameLayout">

	<androidx.appcompat.widget.AppCompatTextView
		android:id="@+id/text"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:textColor="?attr/colorOnSurfaceVariant"
		android:textSize="@dimen/default_desc_text_size"
		app:lineHeight="@dimen/ui_line_height_body"
		tools:text="@string/ais_my_vessel_footer" />
</merge>
