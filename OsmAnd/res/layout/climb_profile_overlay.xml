<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/climb_profile_overlay_container"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@android:color/transparent"
	android:padding="@dimen/content_padding_small"
	android:paddingBottom="70dp">

	<!-- Background with transparent color -->
	<LinearLayout
		android:id="@+id/climb_profile_background"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="@android:color/transparent"
		android:orientation="vertical"
		android:padding="@dimen/content_padding">

		<!-- Header with VAM and current grade -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:paddingBottom="@dimen/content_padding_small">

			<!-- VAM (Vertical Ascent per Minute) - linkerboven -->
			<TextView
				android:id="@+id/climb_profile_vam"
				style="@style/TitleStyle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:textColor="@android:color/black"
				android:shadowColor="@android:color/white"
				android:shadowRadius="2"
				android:shadowDx="1"
				android:shadowDy="1"
				android:text="0 vm/h" />

			<View
				android:layout_width="1dp"
				android:layout_height="@dimen/list_content_padding_large"
				android:background="@android:color/black" />

			<!-- Average grade (gemiddelde stijgingspercentage) - middenboven -->
			<TextView
				android:id="@+id/climb_profile_average_grade"
				style="@style/TitleStyle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:gravity="center"
				android:textColor="@android:color/black"
				android:shadowColor="@android:color/white"
				android:shadowRadius="2"
				android:shadowDx="1"
				android:shadowDy="1" />

			<View
				android:layout_width="1dp"
				android:layout_height="@dimen/list_content_padding_large"
				android:background="@android:color/black" />

			<!-- Current grade (huidige stijgingspercentage) - rechterboven -->
			<TextView
				android:id="@+id/climb_profile_current_grade"
				style="@style/TitleStyle"
				android:layout_width="0dp"
				android:layout_height="wrap_content"
				android:layout_weight="1"
				android:gravity="end"
				android:textColor="@android:color/black"
				android:shadowColor="@android:color/white"
				android:shadowRadius="2"
				android:shadowDx="1"
				android:shadowDy="1" />

		</LinearLayout>

		<!-- Elevation profile visualization with transparent background -->
		<FrameLayout
			android:id="@+id/climb_profile_chart_container"
			android:layout_width="match_parent"
			android:layout_height="150dp"
			android:paddingTop="@dimen/content_padding_small"
			android:paddingBottom="@dimen/content_padding_small">

			<!-- Elevation profile will be added programmatically -->
			<FrameLayout
				android:id="@+id/climb_profile_elevation_container"
				android:layout_width="match_parent"
				android:layout_height="match_parent" />

			<!-- Current position indicator -->
			<View
				android:id="@+id/climb_profile_position_indicator"
				android:layout_width="2dp"
				android:layout_height="match_parent"
				android:background="@color/marker_red" />

		</FrameLayout>

		<!-- Bottom info: elevation gain -->
		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:gravity="center_vertical"
			android:paddingTop="@dimen/content_padding_small">

			<!-- Elevation gain - centraal -->
			<TextView
				android:id="@+id/climb_profile_elevation_gain"
				style="@style/DescStyle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:gravity="center"
				android:text="+0m"
				android:textColor="@android:color/black"
				android:shadowColor="@android:color/white"
				android:shadowRadius="2"
				android:shadowDx="1"
				android:shadowDy="1" />

		</LinearLayout>

	</LinearLayout>

</FrameLayout>
