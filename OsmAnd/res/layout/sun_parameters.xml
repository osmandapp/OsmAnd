<?xml version="1.0" encoding="utf-8"?><!--
	Sun panel below the map preview. Inflated with the Material 3 theme by SunParametersFragment:
	the mode toggle, then one group of rows - the rows of the other modes are hidden.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="?attr/colorSurface"
	android:orientation="vertical">

	<com.google.android.material.button.MaterialButtonToggleGroup
		android:id="@+id/mode_toggle"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginStart="@dimen/content_padding"
		android:layout_marginTop="@dimen/content_padding"
		android:layout_marginEnd="@dimen/content_padding"
		app:selectionRequired="true"
		app:singleSelection="true">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/mode_live"
			style="@style/Widget.Material3Expressive.Button"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/sun_light_live"
			android:textColor="@color/ui_toggle_button_text"
			app:backgroundTint="@color/ui_toggle_button_background" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/mode_date"
			style="@style/Widget.Material3Expressive.Button"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/shared_string_date"
			android:textColor="@color/ui_toggle_button_text"
			app:backgroundTint="@color/ui_toggle_button_background" />

		<com.google.android.material.button.MaterialButton
			android:id="@+id/mode_manual"
			style="@style/Widget.Material3Expressive.Button"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:text="@string/shared_string_manual"
			android:textColor="@color/ui_toggle_button_text"
			app:backgroundTint="@color/ui_toggle_button_background" />
	</com.google.android.material.button.MaterialButtonToggleGroup>

	<LinearLayout
		android:id="@+id/sun_rows"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/ui_group_gap"
		android:orientation="vertical">

		<include
			android:id="@+id/azimuth_row"
			layout="@layout/item_ui_setting_row" />

		<include
			android:id="@+id/altitude_row"
			layout="@layout/item_ui_setting_row" />

		<include
			android:id="@+id/date_row"
			layout="@layout/item_ui_setting_row" />

		<include
			android:id="@+id/time_row"
			layout="@layout/item_ui_slider_list_item" />

		<include
			android:id="@+id/azimuth_slider_row"
			layout="@layout/item_ui_slider_list_item" />

		<include
			android:id="@+id/altitude_slider_row"
			layout="@layout/item_ui_slider_list_item" />
	</LinearLayout>

	<LinearLayout
		android:id="@+id/shadows_rows"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="@dimen/ui_group_gap"
		android:orientation="vertical">

		<include
			android:id="@+id/shadows_row"
			layout="@layout/item_ui_setting_row" />
	</LinearLayout>
</LinearLayout>
