<?xml version="1.0" encoding="utf-8"?><!--
	Travel speed of a profile. Built from the shared Material 3 components (net.osmand.plus.widgets.ui).
	Values are committed immediately, there is no Save button.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/root"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/colorSurface"
	android:orientation="vertical">

	<include layout="@layout/ui_material_app_bar" />

	<ScrollView
		android:id="@+id/scroll_view"
		android:layout_width="match_parent"
		android:layout_height="match_parent">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:orientation="vertical"
			android:paddingTop="@dimen/ui_group_gap"
			android:paddingBottom="@dimen/content_padding">

			<LinearLayout
				android:id="@+id/default_speed_rows"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">

				<include
					android:id="@+id/default_speed_row"
					layout="@layout/item_ui_slider_list_item" />
			</LinearLayout>

			<net.osmand.plus.widgets.ui.GroupFooterView
				android:id="@+id/default_speed_footer"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:groupFooterText="@string/default_speed_descr" />

			<!-- hidden together with its footer for straight line profiles -->
			<LinearLayout
				android:id="@+id/speed_range_rows"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">

				<include
					android:id="@+id/speed_range_row"
					layout="@layout/item_ui_slider_list_item" />
			</LinearLayout>

			<net.osmand.plus.widgets.ui.GroupFooterView
				android:id="@+id/speed_range_footer"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:groupFooterText="@string/speed_range_descr" />

			<net.osmand.plus.widgets.ui.GroupHeaderView
				android:id="@+id/eta_header"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				app:groupHeaderTitle="@string/eta_group_header" />

			<LinearLayout
				android:id="@+id/eta_rows"
				android:layout_width="match_parent"
				android:layout_height="wrap_content"
				android:orientation="vertical">

				<include
					android:id="@+id/adapt_speed_row"
					layout="@layout/item_ui_setting_row" />

				<include
					android:id="@+id/interval_row"
					layout="@layout/item_ui_slider_list_item" />
			</LinearLayout>

			<net.osmand.plus.widgets.ui.GroupFooterView
				android:id="@+id/eta_footer"
				android:layout_width="match_parent"
				android:layout_height="wrap_content" />
		</LinearLayout>
	</ScrollView>
</LinearLayout>
