<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent" android:layout_height="wrap_content"
	android:minHeight="56dp" android:orientation="horizontal"
	android:gravity="center_vertical" android:paddingHorizontal="@dimen/content_padding"
	android:foreground="?attr/selectableItemBackground">
	<net.osmand.plus.widgets.TextViewEx android:id="@+id/title"
		android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
		android:textSize="@dimen/default_list_text_size" app:typefaceWeight="medium" />
	<ImageView android:id="@+id/arrow" android:layout_width="@dimen/standard_icon_size"
		android:layout_height="@dimen/standard_icon_size" android:importantForAccessibility="no" />
</LinearLayout>
