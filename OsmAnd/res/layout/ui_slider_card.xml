<?xml version="1.0" encoding="utf-8"?><!--
	Card with a title, the current value and a slider. The slider commits immediately, there is
	no Save button - the value is mapped to the index of a non-linear scale.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/bg_ui_card_16"
	android:orientation="vertical"
	android:paddingTop="@dimen/content_padding"
	android:paddingBottom="@dimen/content_padding_small">

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:paddingStart="@dimen/content_padding"
		android:paddingEnd="@dimen/content_padding">

		<net.osmand.plus.widgets.TextViewEx
			android:id="@+id/title"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:textColor="?attr/colorOnSurface"
			android:textSize="@dimen/default_list_text_size"
			app:typefaceWeight="medium"
			tools:text="@string/ais_mark_as_outdated" />

		<TextView
			android:id="@+id/value"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="@dimen/content_padding"
			android:textColor="?attr/colorOnSurfaceVariant"
			android:textSize="@dimen/default_list_text_size"
			tools:text="4 min" />
	</LinearLayout>

	<com.google.android.material.slider.Slider
		android:id="@+id/slider"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginStart="@dimen/content_padding_half"
		android:layout_marginTop="@dimen/content_padding_half"
		android:layout_marginEnd="@dimen/content_padding_half"
		android:stepSize="1"
		android:valueFrom="0"
		android:valueTo="6"
		app:labelBehavior="gone"
		app:tickVisible="true"
		app:trackColorInactive="?attr/colorSurfaceContainerHighest" />
</LinearLayout>
