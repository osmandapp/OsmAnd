<?xml version="1.0" encoding="utf-8"?><!--
	Row of a segmented settings list. The background and the corner radius are assigned by
	SegmentedList, depending on the position of the row inside its group.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/bg_ui_segment_middle"
	android:clickable="true"
	android:focusable="true"
	android:gravity="center_vertical"
	android:minHeight="@dimen/ui_row_min_height"
	android:orientation="horizontal"
	android:paddingStart="@dimen/content_padding"
	android:paddingEnd="@dimen/content_padding">

	<androidx.appcompat.widget.AppCompatImageView
		android:id="@+id/icon"
		android:layout_width="@dimen/ui_icon_size"
		android:layout_height="@dimen/ui_icon_size"
		android:layout_marginEnd="@dimen/ui_row_icon_gap"
		android:importantForAccessibility="no"
		tools:src="@drawable/ic_action_ais_cpa" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical"
		android:paddingTop="@dimen/content_padding_small"
		android:paddingBottom="@dimen/content_padding_small">

		<net.osmand.plus.widgets.TextViewEx
			android:id="@+id/title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textColor="?attr/colorOnSurface"
			android:textSize="@dimen/default_list_text_size"
			app:lineHeight="@dimen/ui_line_height_title"
			tools:text="@string/ais_objects_visibility" />

		<androidx.appcompat.widget.AppCompatTextView
			android:id="@+id/subtitle"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textColor="?attr/colorOnSurfaceVariant"
			android:textSize="@dimen/default_desc_text_size"
			android:visibility="gone"
			app:lineHeight="@dimen/ui_line_height_body"
			tools:text="@string/ais_mmsi_not_set"
			tools:visibility="visible" />
	</LinearLayout>

	<com.google.android.material.materialswitch.MaterialSwitch
		android:id="@+id/switch_widget"
		android:layout_width="wrap_content"
		android:layout_height="@dimen/ui_switch_height"
		android:layout_marginStart="@dimen/content_padding"
		android:clickable="false"
		android:focusable="false"
		android:visibility="gone"
		tools:visibility="visible" />
</LinearLayout>
