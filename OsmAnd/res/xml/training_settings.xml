<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:title="@string/training">

    <PreferenceCategory
        android:key="training_category"
        android:title="@string/training_parameters">

        <EditTextPreference
            android:key="training_body_weight"
            android:defaultValue="80"
            android:inputType="numberDecimal"
            android:persistent="true"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="@string/rider_body_weight"
            android:summary="%s kg"
            tools:summary="80 kg" />

        <EditTextPreference
            android:key="training_ftp"
            android:defaultValue="200"
            android:inputType="number"
            android:persistent="true"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="@string/ftp"
            android:summary="%s W"
            tools:summary="200 W" />

    </PreferenceCategory>

    <Preference
        android:layout="@layout/card_bottom_divider"
        android:selectable="false" />

</PreferenceScreen>
